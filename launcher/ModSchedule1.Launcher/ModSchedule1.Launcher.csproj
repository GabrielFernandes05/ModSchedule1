<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8: já vem no Windows 10/11, então o .exe roda sem instalar nada e sem janela de console. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ModSchedule1</AssemblyName>
    <RootNamespace>ModSchedule1.Launcher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.10.0</Version>
    <Product>ModSchedule1</Product>
    <Company>ModSchedule1</Company>
    <ReleaseDir>$(MSBuildThisFileDirectory)../../release/launcher</ReleaseDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!-- version.txt é o que os launchers instalados comparam para se atualizar sozinhos. -->
  <Target Name="CopyToRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseDir)" />
    <WriteLinesToFile File="$(ReleaseDir)/version.txt" Lines="$(Version)" Overwrite="true" />
    <Message Importance="high" Text="ModSchedule1.exe $(Version) -> $(ReleaseDir)" />
  </Target>

</Project>
