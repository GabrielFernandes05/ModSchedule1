<Project Sdk="Microsoft.NET.Sdk">
  <!-- Verificação da lógica de arquivos do launcher (backup, instalação limpa, sync) numa pasta de jogo falsa.
       Roda em qualquer SO com: dotnet run, nesta pasta (baixa o zip do MelonLoader na primeira vez). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>SYSLIB0014;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ModSchedule1.Launcher/Engine.cs" />
  </ItemGroup>
</Project>
